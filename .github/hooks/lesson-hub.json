{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ./.github/scripts/session-context.sh",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "bash ./.github/scripts/guard-lesson-hub.sh",
        "timeout": 10
      }
    ]
  }
}